{
  "name": "@osolmaz/hf-job-control",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Cooperative control and durable progress for Hugging Face Jobs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osolmaz/hf-job-control.git"
  },
  "keywords": [
    "pi-package",
    "agent-skill",
    "hugging-face",
    "job-control",
    "progress"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./typescript-dist/src/index.d.ts",
      "import": "./typescript-dist/src/index.js"
    }
  },
  "files": [
    "typescript-dist/src",
    "schemas",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('typescript-dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "format": "prettier --check package.json tsconfig.json typescript",
    "format:write": "prettier --write package.json tsconfig.json typescript",
    "test": "npm run build && node --test typescript-dist/tests/*.test.js",
    "check": "npm run format && npm test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3"
  },
  "pi": {
    "skills": [
      "./skills/hf-job-control"
    ]
  }
}
