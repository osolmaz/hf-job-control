{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/osolmaz/hf-job-control/blob/main/schemas/progress-pointer-v1.schema.json",
  "title": "HF Job Control progress pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sequence", "updated_at", "snapshot"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "key", "sha256", "bytes"],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "key": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
