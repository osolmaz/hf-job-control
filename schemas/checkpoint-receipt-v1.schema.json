{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/osolmaz/hf-job-control/blob/main/schemas/checkpoint-receipt-v1.schema.json",
  "title": "HF Job Control checkpoint receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "attempt_id",
    "plan_sha256",
    "sequence",
    "checkpoint",
    "adapter",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["restore", "terminal"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "attempt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "checkpoint": { "$ref": "artifact-ref-v1.schema.json" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "resume_mode"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "version": { "type": "integer", "minimum": 1 },
        "resume_mode": { "enum": ["exact", "boundary", "restart", "unsupported"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "evidence": { "type": "object" }
  }
}
