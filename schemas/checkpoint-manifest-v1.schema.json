{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/osolmaz/hf-job-control/blob/main/schemas/checkpoint-manifest-v1.schema.json",
  "title": "HF Job Control checkpoint manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "adapter",
    "plan_sha256",
    "boundary",
    "previous_checkpoint_sha256",
    "payloads",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "resume_mode"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": { "type": "integer", "minimum": 1 },
        "resume_mode": {
          "enum": ["exact", "boundary", "restart", "unsupported"]
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundary": { "type": "object" },
    "previous_checkpoint_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
